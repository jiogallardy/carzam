{
  "expo": {
    "name": "Carzam",
    "slug": "carzam",
    "version": "0.1.0",
    "scheme": "carzam",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050507",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050507"
    },
    "ios": {
      "bundleIdentifier": "com.carzam.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Carzam listens to engine sound to identify the car.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "sslip.io": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      }
    },
    "android": {
      "package": "com.carzam.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5E9D9"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-av",
        {
          "microphonePermission": "Carzam listens to engine sound to identify the car."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.28068275828-6ia8mpkvm9m0rmvnsbkbcmr84qd7e0kn"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a780971e-51f2-4fa3-be6a-03b1824cb8ee"
      }
    },
    "owner": "jiogallardy"
  }
}
