# =============================================================================
# carzam-api — environment variables
# =============================================================================
# The core `carzam` CLI (training, inference, auto-label) reads NO env vars —
# everything is CLI-flag driven. This file only matters if you're running the
# FastAPI server in `apps/carzam-api/`.
#
# Only the model-related vars are documented below. If you also want auth,
# Postgres, CORS, admin endpoints, etc., add them per `app/config.py`.
# =============================================================================

# --- Model storage (Cloudflare R2) -------------------------------------------
# The API fetches the trained checkpoint + classes.json from R2 on startup,
# so the Docker image stays small and you can swap checkpoints without
# rebuilding. Create an R2 bucket + API token in the Cloudflare dashboard.
R2_ACCOUNT_ID=your_cf_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=carzam-clips

# Optional: override the keys where the checkpoint + classes live.
# Defaults work for the layout produced by scripts/upload_model_to_r2.py.
# MODEL_R2_KEY=model/checkpoint.pt
# CLASSES_R2_KEY=model/classes.json
# MODEL_RUN_ID=20260507_174723

# Optional: pick a non-default active model id (e.g. "v6" or a run timestamp).
# Falls back to the legacy `model/checkpoint.pt` layout when unset.
# DEFAULT_MODEL_ID=v6
