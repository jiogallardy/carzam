# Postgres (Coolify injects this when you attach a managed Postgres)
DATABASE_URL=postgresql+asyncpg://carzam:CHANGE_ME@db:5432/carzam

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-random-hex
JWT_TTL_DAYS=30

# Google Sign-In (iOS client ID from Google Cloud Console)
GOOGLE_CLIENT_ID_IOS=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Apple Sign-In
APPLE_TEAM_ID=ABCDE12345
APPLE_BUNDLE_ID=com.carzam.app

# Cloudflare R2
R2_ACCOUNT_ID=your_cf_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=carzam-clips

# CORS — for prod, list your allowed origins explicitly.
# CORS_ORIGINS=["https://api.carzam.app"]
